{
  "manifest_version": 3,
  "name": "Open Author Clock",
  "version": "1.0.0",
  "description": "A literary clock displaying quotes from literature for each minute of the day with integrated search",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "favicons/favicon-16x16.png",
    "32": "favicons/favicon-32x32.png",
    "48": "favicons/favicon-32x32.png",
    "128": "favicons/apple-touch-icon.png"
  },
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["data.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
